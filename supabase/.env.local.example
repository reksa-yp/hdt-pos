# Salin file ini jadi ".env.local" (di folder yang sama) untuk uji coba
# lokal dengan `supabase functions serve`. JANGAN commit file ".env.local"
# (sudah masuk .gitignore).

SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=isi-dengan-hasil-`supabase status`
HMAC_SECRET=ganti-dengan-string-acak-panjang
